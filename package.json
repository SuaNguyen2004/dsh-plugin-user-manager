{
  "name": "dsh-plugin-user-manager",
  "version": "0.1.0",
  "description": "Multi-user authentication, workspace isolation and quota management for DeepSeek Harness (DSH)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "scripts": {
