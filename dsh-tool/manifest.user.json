{
  "role": "user",
  "version": "1.0.0",
  "toolsDir": "/opt/dsh-tool/tools/user",
  "allowedRoots": ["/data"],
  "tools": {
    "bash": {
      "module": "shell.js",
      "handler": "runBash",
      "description": "Execute shell commands strictly inside /data/<user>/<ws>"
    },
    "read_file": {
      "module": "fs.js",
      "handler": "readFile",
      "description": "Read file content inside /data/<user>/<ws>"
    },
    "write_file": {
      "module": "fs.js",
      "handler": "writeFile",
      "description": "Write file into /data/<user>/<ws>/files/<category>/<file>"
    },
    "edit_file": {
      "module": "fs.js",
      "handler": "editFile",
      "description": "Edit file in /data/<user>/<ws>"
    },
    "list_dir": {
      "module": "fs.js",
      "handler": "listDir",
      "description": "List directory entries in /data/<user>/<ws>"
    },
    "stat_file": {
      "module": "fs.js",
      "handler": "statFile",
      "description": "Stat file or directory in /data/<user>/<ws>"
    },
    "read_bytes": {
      "module": "fs.js",
      "handler": "readBytes",
      "description": "Read binary bytes of a file in /data/<user>/<ws>"
    },
    "upload_file": {
      "module": "fs.js",
      "handler": "uploadFile",
      "description": "Save uploaded file into /data/<user>/<ws>/files/<category>/<file>"
    },
    "search_files": {
      "module": "fs.js",
      "handler": "searchFiles",
      "description": "Search file names or text inside /data/<user>/<ws>"
    },
    "ensure_workspace": {
      "module": "fs.js",
      "handler": "ensureWorkspace",
      "description": "Create or normalize workspace folder under /data/<user>/<ws>"
    },
    "read_document": {
      "module": "doc-reader.js",
      "handler": "readDocument",
      "description": "Extract text from .docx, .pdf, .txt inside /data/<user>/<ws>"
    }
  }
}
